# PolicyLens configuration
# setup.bat copies this file to .env (and generates JWT_SECRET) the first time it runs.
# Fill in every value marked REQUIRED. Never commit .env - it is git-ignored.

# --- Google Gemini (REQUIRED) -------------------------------------------------
# Free API key: open https://aistudio.google.com/apikey, sign in with a Google
# account, click "Create API key", then copy the key (it starts with "AIza").
GEMINI_API_KEY=

# Main model for Policy Card extraction, answers, Claim Copilot and comparison.
# Current model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Lighter model for quick tasks such as translating a Hindi/Telugu question into
# an English search query.
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Models tried in order when the main model is overloaded (503/504) or out of
# quota (429), after a short retry. Comma-separated; leave empty to disable.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Seconds to wait for one Gemini response before giving up on that attempt.
GEMINI_TIMEOUT_SECONDS=90

# Most Gemini requests per minute PolicyLens will send. Keep this at or below the
# limit shown for your key in AI Studio (Dashboard -> Rate limits).
LLM_MAX_RPM=10

# Dense-retrieval embeddings: "local" (all-MiniLM-L6-v2, offline, no quota)
# or "gemini" (uses GEMINI_EMBEDDING_MODEL through the API).
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Languages -----------------------------------------------------------------
# Answer languages offered in Settings, as ISO codes: en = English, hi = Hindi, te = Telugu.
SUPPORTED_LANGUAGES=en,hi,te

# --- Security ------------------------------------------------------------------
# Secret used to sign login tokens. setup.bat generates a random one; any long
# random string works. Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Ports (fixed for this product; other products may run on the same PC) ------
BACKEND_PORT=8101
FRONTEND_PORT=5101
CORS_ORIGINS=http://localhost:5101,http://127.0.0.1:5101

# --- Storage -------------------------------------------------------------------
# Folders are relative to the project root.
DATA_DIR=data
MODELS_DIR=models
MAX_UPLOAD_MB=25

# --- Logging -------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Demo account (created on first run, owns the labelled sample policies) -----
DEMO_EMAIL=demo@policylens.app
DEMO_PASSWORD=Demo@12345
