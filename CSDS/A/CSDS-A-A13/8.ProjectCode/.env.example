# =====================================================================
# SeatWise configuration
# Copy this file to ".env" (setup.bat does this for you) and adjust.
# ".env" is private and is never committed. No external API keys are
# needed: SeatWise runs fully offline.
# =====================================================================

# ---- Runtime ---------------------------------------------------------
# "development" shows detailed errors in the API; use "production" for
# a shared machine.
APP_ENV=development
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# ---- Ports (fixed so SeatWise can run next to other products) -------
# Backend API. The browser never calls it directly: the frontend dev
# server forwards /api to it.
API_HOST=127.0.0.1
API_PORT=8113
# Frontend (the address you open in the browser).
WEB_PORT=5113

# ---- Security --------------------------------------------------------
# Secret used to sign login tokens. setup.bat generates a random one.
# To make your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-run-setup-bat-to-generate-a-random-secret
# How long a login stays valid, in minutes (720 = 12 hours).
JWT_EXPIRE_MINUTES=720

# ---- Database --------------------------------------------------------
# SQLite file, relative to this folder. Created automatically on first run.
DATABASE_URL=sqlite:///data/app.db

# ---- Web access ------------------------------------------------------
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5113,http://127.0.0.1:5113
# Address printed inside QR slips. Candidates scanning a slip with a
# phone open this address. To let phones on the same Wi-Fi use it,
# replace localhost with this PC's local IP address, for example
# http://192.168.1.20:5113 (find it with "ipconfig" -> IPv4 Address).
PUBLIC_BASE_URL=http://localhost:5113

# ---- Demo accounts (created on first start when the database is empty) ---
SEED_DEMO_USERS=true
DEMO_ADMIN_EMAIL=admin@seatwise.local
DEMO_INVIGILATOR_EMAIL=invigilator@seatwise.local
# Password for all demo accounts. Change it before sharing the machine.
DEMO_PASSWORD=SeatWise@2026

# ---- Seating engine ---------------------------------------------------
# Halls solved in parallel. 0 = use all CPU cores.
SOLVER_THREADS=0
# Deterministic time budget per hall (solver "seconds"). Leave empty to
# use the tuned value in models/engine_profile.json.
SOLVER_HALL_BUDGET=
# How many times the engine may re-balance halls before giving up.
SOLVER_MAX_RETRIES=5

# ---- Public seat lookup ----------------------------------------------
# Maximum lookups per minute from one device (protects candidate data).
LOOKUP_RATE_LIMIT_PER_MINUTE=30
