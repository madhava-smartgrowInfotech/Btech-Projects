# Copy to .env and `export $(cat .env | xargs)` (or set in your host's env)
AM_BASE_URL=https://attendance.yourcollege.edu     # used to build session links
AM_JWT_SECRET=replace-with-a-long-random-string
DATABASE_URL=sqlite:///attendance_magic.db
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
AM_ALLOW_MANUAL_LOCATION=false   # true only for development/demo
AM_MAX_DEVICES_PER_STUDENT=1
AM_DEFAULT_RADIUS_M=60
AM_IDENTITY_THRESHOLD=0.40
AM_DUPLICATE_THRESHOLD=0.45
AM_CAMERA_MIRRORED=true
AM_TIMEZONE=Asia/Kolkata
