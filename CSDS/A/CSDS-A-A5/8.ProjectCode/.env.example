# TaxSentinel configuration
# setup.bat copies this file to .env (and generates JWT_SECRET) the first time it runs.
# Never commit .env - it is git-ignored.

# --- Google Gemini (REQUIRED for written explanations) -------------------------
# Free key: open https://aistudio.google.com/apikey, sign in, click "Create API key",
# and paste the key (starts with "AIza") here.
GEMINI_API_KEY=
# Model used for case narratives; fallbacks are tried in order on quota/overload errors.
# Model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Kaggle (OPTIONAL - only for scripts/download_data.py) ---------------------
# PaySim is public and usually downloads without credentials. If Kaggle asks for them:
# kaggle.com -> Settings -> API -> "Create New Token", then copy username and key here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Security ------------------------------------------------------------------
# Signs login tokens. setup.bat generates a random value; any long random string works.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- Ports (fixed for this product; other products may run on the same PC) ------
BACKEND_PORT=8105
FRONTEND_PORT=5105
CORS_ORIGINS=http://localhost:5105,http://127.0.0.1:5105

# --- Demo account (created on first start) --------------------------------------
DEMO_EMAIL=demo@taxsentinel.app
DEMO_PASSWORD=Demo@1234
