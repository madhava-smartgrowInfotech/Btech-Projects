# ClauseGuard environment variables
# Copy this file to .env and fill in the values. .env is git-ignored.

# Gemini API key - get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model names (defaults are fast/cheap and widely available)
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Backend
BACKEND_PORT=8106
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Frontend
FRONTEND_PORT=5106
VITE_API_BASE=/api
