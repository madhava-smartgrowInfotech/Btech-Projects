# Copy this file to .env and fill in real values. Never commit .env.

# --- Ports (fixed - do not change) ---
BACKEND_PORT=8107
FRONTEND_PORT=5107

# --- Auth ---
# Any long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# --- Gemini (AI safety assistant) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Telegram (free guardian alerts) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts, copy the token below.
# 2. Each guardian starts a chat with your bot and sends /start; you find their chat_id via
#    https://api.telegram.org/bot<token>/getUpdates (guided: https://core.telegram.org/bots/tutorial)
#    Guardian chat IDs are stored per-guardian in the app, not here.
TELEGRAM_BOT_TOKEN=

# --- Gmail SMTP (free email alerts) ---
# Use a Gmail address + a 16-character App Password (Google Account > Security > App passwords).
# Requires 2-Step Verification to be enabled on the Gmail account.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db
