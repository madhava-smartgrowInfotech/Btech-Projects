# CivicPulse configuration - copy to .env and fill in the values.

# Gemini API key (structured extraction + draft replies).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IkYPdX4eAGDbNgw98EmTXdYtnfpsAxzt70XdtEn47F7g
# Gemini model name (any text model your key can use)
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is overloaded (HTTP 503)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Secret used to sign login tokens. Any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=683da4261541d12f1c701813ccd73a35b7796f27147ca3408ac1b11fcb3a1a9c

# Fixed ports (other services may share this machine)
BACKEND_PORT=8201
FRONTEND_PORT=5201

# SQLite database file (created on first run)
DATABASE_PATH=data/app.db
