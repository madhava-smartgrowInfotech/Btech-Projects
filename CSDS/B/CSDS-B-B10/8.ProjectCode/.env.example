# SkyCipher configuration. Copy to .env (setup.bat does this for you).

# Secret used to sign login tokens (JWT). Generate any long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Fixed ports (other products may run on this PC at the same time)
BACKEND_PORT=8210
FRONTEND_PORT=5210

# SQLite database file (created on first run)
DATABASE_URL=sqlite:///./data/app.db

# Demo account created on first start
DEMO_EMAIL=demo@skycipher.app
DEMO_PASSWORD=SkyCipher@2026

# Optional - only needed to re-download the full VisDrone dataset with scripts/download_data.py.
# Public datasets usually download anonymously; if Kaggle asks for credentials, create a token at
# https://www.kaggle.com/settings -> API -> Create New Token and fill these in.
KAGGLE_USERNAME=
KAGGLE_KEY=
