# ---- Ports (fixed so other local products do not clash) ----
BACKEND_PORT=8211
FRONTEND_PORT=5211

# ---- Auth ----
# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# ---- Google Gemini (recipe steps + food photo recognition) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name; "gemini-flash-latest" always points at the current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Comma-separated models tried in order if the main one is unavailable.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# ---- USDA FoodData Central (ingredient lookups) ----
# Optional. Free key at https://fdc.nal.usda.gov/api-key-signup.html
# Leave as DEMO_KEY to use USDA's shared, rate-limited demo key.
USDA_API_KEY=DEMO_KEY
