# Gemini API access
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Server ports
BACKEND_PORT=8212
FRONTEND_PORT=5212

# Security (generate your own: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
JWT_SECRET=change-me-long-random-string
FERNET_KEY=generate-a-fernet-key
DATABASE_URL=sqlite:///data/app.db
