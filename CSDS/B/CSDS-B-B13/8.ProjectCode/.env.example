# APISentry environment - copy to .env and fill in.

# --- Backend ---
BACKEND_PORT=8213
FRONTEND_PORT=5213
# Secret used to sign login JWTs. Change to any long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Seeded demo account (created on first run so you can log in immediately).
DEMO_EMAIL=demo@apisentry.local
DEMO_PASSWORD=demo12345

# --- Scope guard ---
# Comma-separated hosts the scanner is allowed to hit. localhost only by default.
SCOPE_ALLOWLIST=localhost,127.0.0.1

# --- Deliberately vulnerable practice targets (run locally) ---
DEMOPAY_PORT=12130
VULNBANK_PORT=12131

# --- Gemini (F4 AI-generated tests) ---
# Get a key: https://aistudio.google.com/apikey  (leave blank to use the built-in generator)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=60
