# AquaVision configuration - copy to .env (setup.bat does this for you)

# Ports (fixed so AquaVision can run next to other services)
BACKEND_PORT=8214
FRONTEND_PORT=5214

# Secret used to sign login tokens - set any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# SQLite database file (created on first run)
DATABASE_URL=sqlite:///data/app.db

# City used for Open-Meteo weather (free, no key needed - https://open-meteo.com)
CITY_NAME=Hyderabad
CITY_LAT=17.385
CITY_LON=78.4867

# Optional - only needed to re-download the water-quality dataset with scripts/download_data.py
# Get them at https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
