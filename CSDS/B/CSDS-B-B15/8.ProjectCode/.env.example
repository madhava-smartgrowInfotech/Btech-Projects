# MediQueue configuration - copy to .env and fill in.

# Ports (fixed so other local services don't clash)
BACKEND_PORT=8215
FRONTEND_PORT=5215

# JWT signing secret - any long random string (e.g. python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key for free-text symptom mapping - https://aistudio.google.com/apikey
# Leave empty to fall back to built-in keyword matching.
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest
# tried in order when the main model is busy or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Kaggle datasets are already committed under data/. Only needed to re-download
# with scripts/download_data.py (https://www.kaggle.com/settings -> API -> Create New Token).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Overbooking: maximum extra bookings above the OP limit, as a fraction (0.15 = 15 %)
MAX_OVERBOOK=0.15

# Gemini API access (shared key - provided by the project owner)
GEMINI_EMBED_MODEL=gemini-embedding-001
