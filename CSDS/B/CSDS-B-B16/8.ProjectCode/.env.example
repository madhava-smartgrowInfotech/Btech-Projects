# RetinaGuard configuration. Copy to .env (setup.bat does this for you).
# No external API keys are needed: all models run locally.

# Backend API port (FastAPI / Uvicorn)
BACKEND_PORT=8216
# Frontend dev server port (Vite, strictPort)
FRONTEND_PORT=5216
# Secret used to sign login tokens. Generate any long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in minutes
JWT_EXPIRE_MINUTES=720
# SQLite database file (created on first run)
DATABASE_URL=sqlite:///data/app.db
# Password given to the seeded demo accounts on first run
DEMO_PASSWORD=RetinaGuard@123
# Optional: only needed if anonymous Kaggle downloads are ever blocked.
# Create a token at https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
