# CallSense configuration - copy to .env and fill in (setup.bat does this for you).

# Google Gemini API key (call summaries). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the main model is busy, over quota or unavailable
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Secret used to sign login tokens - any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Password for the seeded demo accounts
DEMO_PASSWORD=CallSense@123

# Fixed ports (do not use 8000 / 5173)
BACKEND_PORT=8217
FRONTEND_PORT=5217
DATABASE_URL=sqlite:///data/app.db

# Speech models (CPU)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
EMOTION_MODEL=superb/wav2vec2-base-superb-er

# Optional - public Kaggle datasets download without a token
KAGGLE_USERNAME=
KAGGLE_KEY=
