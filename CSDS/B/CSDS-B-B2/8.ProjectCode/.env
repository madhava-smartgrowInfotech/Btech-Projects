# SignalScout configuration
# Copy this file to .env (setup.bat does it for you) and fill in the values you need.
# Every key is optional unless marked REQUIRED. See docs/08_CONFIGURATION.md for details.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Backend API port (fixed for this product - do not use 8000)
BACKEND_PORT=8202
# Frontend dev server port (fixed for this product - do not use 5173)
FRONTEND_PORT=5202
# Address the backend listens on. 0.0.0.0 lets phones on the same Wi-Fi reach it.
BACKEND_HOST=0.0.0.0
# Base URL that phones and ESP32 nodes use to reach the API.
# Use this PC's LAN IP (e.g. http://192.168.1.20:8202) or a Cloudflare tunnel URL.
PUBLIC_API_URL=http://localhost:8202
# URL of the dashboard, used in notification links
DASHBOARD_URL=http://localhost:5202
# Extra allowed browser origins, comma separated (localhost:5202 is always allowed)
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Security (REQUIRED) - setup.bat generates a random value on first run
# ---------------------------------------------------------------------------
JWT_SECRET=txez4V4BxYuzbE7FqnKvULLDzFffUMGvpoYr6XHAvzYKrjCiyhaWgSNvV_ce3v6z
# How long a login stays valid, in hours
JWT_EXPIRE_HOURS=12

# ---------------------------------------------------------------------------
# Database - SQLite file, created automatically on first run
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/app.db

# ---------------------------------------------------------------------------
# First-run data
# ---------------------------------------------------------------------------
# Create the demo accounts (user / engineer / admin)
SEED_DEMO_USERS=true
# Replay a few public-dataset traces through the real pipeline (tagged "Sample")
SEED_SAMPLE_DATA=true

# ---------------------------------------------------------------------------
# Zone detection and auto-complaint thresholds (admins can change these in Settings)
# ---------------------------------------------------------------------------
# H3 hexagon resolution for zones (9 = about 0.1 km2 per zone)
H3_RESOLUTION=9
# Minimum readings in the window before a zone can be judged
DETECT_MIN_READINGS=8
# Sliding window length in minutes
DETECT_WINDOW_MIN=30
# Share of Weak/Dead readings that makes a zone "bad" (0-1)
DETECT_BAD_SHARE=0.7
# Minutes a zone must stay bad before the complaint is registered
DETECT_PERSIST_MIN=15
# Auto-verification after a complaint is resolved
VERIFY_MIN_READINGS=5
VERIFY_STRONG_SHARE=0.7
VERIFY_REOPEN_SHARE=0.5
VERIFY_TIMEOUT_DAYS=7

# ---------------------------------------------------------------------------
# ESP32 simulator (used when no ESP32 hardware is available)
# ---------------------------------------------------------------------------
ESP32_SIMULATOR=true
ESP32_SIMULATOR_NODES=3
# Seconds between simulated node reports
ESP32_SIMULATOR_INTERVAL_S=15
# Where the simulated nodes are placed (decimal degrees). Leave empty for automatic placement:
# near your recent phone readings, otherwise near the sample data.
ESP32_SIMULATOR_LAT=
ESP32_SIMULATOR_LON=

# ---------------------------------------------------------------------------
# Telegram notifications (free)
# Get a token: open Telegram, message @BotFather, send /newbot, copy the token.
# Get the chat ID: send any message to your bot, then run: python scripts/check_env.py --telegram-chat-id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8995680605:AAExkTlMqrtlHhwEVQyiK17-Kx5GrTcR9a0
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Email notifications through Gmail SMTP (free)
# SMTP_PASSWORD is a Gmail *app password* (16 characters), not your normal password:
# Google Account > Security > 2-Step Verification (turn on) > App passwords > create "SignalScout".
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xanartheraphy@gmail.com
SMTP_PASSWORD=nasqkmkfpbvwpllp
SMTP_FROM=SignalScout <xanartheraphy@gmail.com>
# Inbox of the operator complaint desk (receives new/reopened complaint emails)
DESK_EMAIL=xanartheraphy@gmail.com

# ---------------------------------------------------------------------------
# OpenCelliD cell-tower positions (optional, free key)
# Sign up at https://opencellid.org/ > log in > "Access Token" on your profile page.
# ---------------------------------------------------------------------------
OPENCELLID_API_KEY=

# ---------------------------------------------------------------------------
# Google Gemini - plain-language complaint summaries (optional, free tier)
# Get a key at https://aistudio.google.com/apikey > "Create API key".
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Kaggle (optional) - only needed if anonymous dataset download is ever blocked
# kaggle.com > Settings > API > "Create New Token" downloads kaggle.json with both values.
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=

# Added by scripts/sync_env.py (new settings)
TUNNEL_ENABLED=true
PROBE_INTERVAL_S=10
PROBE_SPEEDTEST_INTERVAL_S=60
PROBE_SPEEDTEST_MAX_BYTES=1000000
PROBE_WEAK_RTT_MS=400
PROBE_WEAK_DL_MBPS=2
