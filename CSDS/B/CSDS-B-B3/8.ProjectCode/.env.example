# KnowledgeX AI - Environment Configuration
# Copy this file to .env and fill in values before enabling external-API mode.
# The app runs fully in LOCAL MODE with no keys required.

# AI_MODE controls the AI abstraction layer: "local" (default, no key needed) or "api"
AI_MODE=local

# Only required if AI_MODE=api. Never commit real keys to source control.
LLM_API_KEY=

# Optional: override the SQLite database path
DATABASE_URL=sqlite:///knowledgex.db

# Change this before any production deployment
DEMO_PASSWORD=Demo@1234
