# UPI Guardian - configuration
# Copy this file to .env (setup.bat does it for you) and adjust the values.
# Every key is explained in docs/08_CONFIGURATION.md.

# ---------------------------------------------------------------------------
# Ports - fixed so UPI Guardian can run next to other products on this PC.
# Extra local services, if you ever add any, must use 12040-12049.
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8204
FRONTEND_PORT=5204
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5204,http://127.0.0.1:5204

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Secret used to sign login tokens. setup.bat generates a random one.
# To make your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=pPkODKybLV_yW4TqJrPFufJfWQHuibNGyZqibcTyYqQVGR6vne8qIn7dtysX0sbV
# How long a login stays valid, in minutes (720 = 12 hours).
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# Database - a single SQLite file, created automatically on first start.
# Relative paths are resolved from this folder.
# ---------------------------------------------------------------------------
DATABASE_PATH=data/app.db
# Load the labelled sample accounts, contacts and history on first start.
SEED_SAMPLE_DATA=true
# Starting balance of every new sandbox wallet, in rupees (no real money).
SANDBOX_START_BALANCE=50000

# ---------------------------------------------------------------------------
# Risk policy defaults (score 0-100). The tuned values in models/risk_policy.json
# take priority once the models are trained; admins can change them in the app.
# ---------------------------------------------------------------------------
RISK_MEDIUM_THRESHOLD=35
RISK_HIGH_THRESHOLD=70
# Delayed Protection Mode: default cooling-off time for high-risk payments.
HOLD_MINUTES_DEFAULT=30
# How often the hold scheduler checks for payments to release, in seconds.
HOLD_CHECK_SECONDS=5

# ---------------------------------------------------------------------------
# Voice assistant (gTTS). Needs internet for phrases that are not cached yet.
# ---------------------------------------------------------------------------
TTS_ENABLED=true
VOICE_CACHE_DIR=data/voice_cache

# ---------------------------------------------------------------------------
# Logging: DEBUG, INFO, WARNING or ERROR
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional - Kaggle API token, only used by scripts/download_data.py.
# The datasets are already committed and public, so this is normally not needed.
# Get it at https://www.kaggle.com/settings -> API -> "Generate New Token".
# ---------------------------------------------------------------------------
KAGGLE_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional - full path to cloudflared.exe for run_phone.bat.
# Leave empty to use the default install location or PATH.
# Install it with: winget install --id Cloudflare.cloudflared
# ---------------------------------------------------------------------------
CLOUDFLARED_PATH=
