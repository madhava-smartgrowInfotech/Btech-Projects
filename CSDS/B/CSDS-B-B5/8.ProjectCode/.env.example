# Gemini (optional - polishes sentences when online)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ports (fixed)
BACKEND_PORT=8205
FRONTEND_PORT=5205

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Offline speech-to-text (faster-whisper model size: tiny / base / small)
WHISPER_MODEL=small
