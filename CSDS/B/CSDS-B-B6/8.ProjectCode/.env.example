# ---- UniHealth configuration (copy to .env and fill in) ----

# Gemini API key for the AI assistant - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model name (any text model available to your key)
GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign user login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret the platform and the hospital FHIR servers use to sign service tokens
HOSPITAL_SHARED_SECRET=change-me-hospital-shared-secret

# Ports (fixed so UniHealth can run next to other products)
BACKEND_PORT=8206
FRONTEND_PORT=5206
HOSPITAL_A_PORT=12061
HOSPITAL_B_PORT=12062
HOSPITAL_C_PORT=12063

# Password given to every demo account created on first run
DEMO_PASSWORD=demo123
