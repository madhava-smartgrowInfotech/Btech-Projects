# HospiSense configuration. setup.bat copies this file to .env and fills JWT_SECRET with a random value.

# Secret used to sign login tokens. Any long random string (python -c "import secrets; print(secrets.token_hex(32))").
JWT_SECRET=
# Login session length in hours.
JWT_EXPIRE_HOURS=12

# Fixed ports (other products may run on this PC at the same time).
BACKEND_PORT=8207
FRONTEND_PORT=5207

# Optional. Default: sqlite database at data/app.db (created on first run; delete it to reset to the baseline).
# DATABASE_URL=sqlite:///data/app.db

# Optional - only needed if scripts/download_data.py cannot download anonymously.
# Create at https://www.kaggle.com/settings -> API -> "Create New Token".
# KAGGLE_USERNAME=
# KAGGLE_KEY=
