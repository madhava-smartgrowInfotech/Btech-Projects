# Gemini API access (not used by CareWatch features; kept for the shared workspace)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ports (fixed - other products may run on this PC)
BACKEND_PORT=8208
FRONTEND_PORT=5208

# Auth / storage
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///data/app.db

# Camera: 0 = first webcam, or a phone IP Webcam URL such as http://192.168.1.20:8080/video
CAMERA_SOURCE=0

# Telegram alerts: bot token from @BotFather (chat IDs are set per contact in the app)
TELEGRAM_BOT_TOKEN=123456789:your-bot-token

# Gmail SMTP alerts: your Gmail address + a Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
