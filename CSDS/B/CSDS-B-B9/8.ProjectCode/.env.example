# TalentTrack configuration - copy to .env and fill in.

# Google Gemini API key (AI mock interviews, answer feedback, resume tips).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model name (any text model your key can use)
GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign login tokens - any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Fixed ports (do not use 8000 / 5173)
BACKEND_PORT=8209
FRONTEND_PORT=5209

# Code judge limits
JUDGE_TIME_LIMIT_SEC=2
JUDGE_MAX_OUTPUT_KB=8192
# Optional explicit compiler paths (auto-detected from PATH when empty)
GXX_PATH=
JAVAC_PATH=
JAVA_PATH=
