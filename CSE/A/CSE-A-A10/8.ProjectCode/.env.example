# CSE-A-A10 - ports are fixed so several products can run side by side
BACKEND_PORT=8310
FRONTEND_PORT=5310
DATABASE_URL=sqlite:///./data/app.db

# Gemini API access (shared key - provided by the project owner)
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=paste-your-gemini-key-here
JWT_SECRET=generate-a-random-64-char-string

# Demo operator account for the web UI (shown on the sign-in page)
DEMO_EMAIL=operator@flowsense.app
DEMO_PASSWORD=Flow@1234
