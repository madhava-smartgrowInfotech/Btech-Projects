APP_ENV=development

# mock | api | failing | baseline   ("api" needs LLM_API_KEY and LLM_MODEL; otherwise agents use the labelled fallback policy)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# anthropic | openai  (wire format of the API provider)
LLM_API_STYLE=anthropic
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

DATABASE_URL=sqlite:///./safegrid.db

VOLTAGE_MIN=0.95
VOLTAGE_MAX=1.05
LINE_MAX_LOADING_PCT=100
TRAFO_MAX_LOADING_PCT=100

DEFAULT_TIME_STEP_MINUTES=15
DEFAULT_SEED=42
CORS_ORIGINS=http://localhost:5313,http://127.0.0.1:5313
