# ResQAI configuration. Copy to .env (run.bat does this on first launch).
# Never commit .env.
BACKEND_PORT=8302
FRONTEND_PORT=5302

# 0 = only the React console needs a login (the original Flask page at :8302 keeps working).
# 1 = the API itself rejects /api/* calls without a valid login token (the original Flask page stops working).
REQUIRE_AUTH=0

# Optional: key used to sign login tokens. Leave unset to auto-generate one in data/.secret.
# SECRET_KEY=
