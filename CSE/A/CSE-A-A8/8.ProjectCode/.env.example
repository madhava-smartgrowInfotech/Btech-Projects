# Copy this file to ".env". Never commit your real .env file.

# CSE-A-A8 - ports are fixed so several products can run side by side
BACKEND_PORT=8308
FRONTEND_PORT=5308

# Secret used to sign login tokens - change it on first run
JWT_SECRET=change-me-on-first-run

# Optional: enables the "Use LLM for richer explanations" switch on the Upload screen.
# The app works fully without it (built-in rule-based explanations are used).
ANTHROPIC_API_KEY=your_api_key_here
