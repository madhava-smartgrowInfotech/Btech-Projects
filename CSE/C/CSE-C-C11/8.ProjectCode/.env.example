# Copy this file to .env and fill in real values. Never commit .env with real keys.

# Optional: enables the LLM-powered natural-language layer of the AI Assistant.
# If left blank, the AI Assistant still works using rule-based analytics on your data.
AI_API_KEY=

# Optional: enables live market price refresh for investments via yfinance/other providers.
# If left blank, investments fall back to manually entered current prices.
MARKET_DATA_API_KEY=

# App secret used to salt session tokens. Generate any long random string.
APP_SECRET_KEY=change-me-to-a-long-random-string

# Default currency symbol shown across the UI.
DEFAULT_CURRENCY=INR
