# Copy to .env and adjust. Never commit real secrets.
APP_NAME=CipherVault
APP_PORT=8413
FRONTEND_PORT=5413
# Local default (zero setup): sqlite:///./ciphervault.db
# PostgreSQL example: postgresql+psycopg://ciphervault:ciphervault@localhost:5432/ciphervault
DATABASE_URL=sqlite:///./ciphervault.db
# Long random string in real deployments
JWT_SECRET=change-me-to-a-long-random-secret-for-local-use-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
STORAGE_DIR=storage/encrypted
MAX_UPLOAD_MB=25
