# StoryVox environment template. Copy to .env to override defaults.
STORY_MODEL=Qwen/Qwen3-0.6B
TTS_MODEL=facebook/mms-tts-eng
ASR_MODEL=openai/whisper-small
MAX_PROMPT_CHARS=2000
MAX_AUDIO_UPLOAD_MB=10
PORT=8402
FRONTEND_PORT=5402
HOST=127.0.0.1
STORYVOX_DB_PATH=data/storyvox.db
STORYVOX_AUDIO_DIR=data/audio
STORYVOX_EVAL_DIR=data/evaluations
STORYVOX_DATASET_DIR=data/datasets
STORY_MAX_NEW_TOKENS_SHORT=220
STORY_MAX_NEW_TOKENS_MEDIUM=420
STORY_MAX_NEW_TOKENS_LONG=700
STORY_TEMPERATURE=0.8
STORY_TOP_P=0.9
