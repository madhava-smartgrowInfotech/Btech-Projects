# QuantPulse settings. Copy this file to .env (run.bat reads .env).
# Ports
BACKEND_PORT=8404
FRONTEND_PORT=5404
# Optional: live financial news via NewsAPI (https://newsapi.org, free tier).
# Without a key QuantPulse automatically uses its built-in headline fallback.
NEWSAPI_KEY=
# Optional: override the 10-ticker universe (comma-separated).
QP_TICKERS=TSLA,AAPL,AMZN,MSFT,GOOGL,NVDA,META,FDX,IBM,ORCL
