# PeerScope example configuration (copy to .env to override defaults)
PEERSCOPE_HOST=127.0.0.1
PEERSCOPE_PORT=8408
FRONTEND_PORT=5408
VITE_API_URL=http://127.0.0.1:8408
PEERSCOPE_MAX_UPLOAD_MB=20
PEERSCOPE_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
PEERSCOPE_LLM_FALLBACK=Qwen/Qwen2.5-0.5B-Instruct
PEERSCOPE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PEERSCOPE_LITERATURE_COUNT=6
PEERSCOPE_LITERATURE_TIMEOUT=8
PEERSCOPE_W_EXPERTISE=0.55
PEERSCOPE_W_KEYWORD=0.20
PEERSCOPE_W_METHOD=0.15
PEERSCOPE_W_AVAIL=0.10
PEERSCOPE_W_CONFLICT=0.60
